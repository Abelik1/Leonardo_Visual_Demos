# Copy to config/leonardo.env on Leonardo.  The real file is git-ignored.
# `saldo -b` lists the project accounts available to your user.
LEONARDO_ACCOUNT=YOUR_ACTIVE_PROJECT_ACCOUNT

# A tested virtual environment is the simplest launch method.  Alternatively,
# set LEONARDO_CONTAINER to a pre-built .sif and leave LEONARDO_VENV empty.
LEONARDO_VENV=$WORK/venvs/leonardo-visual-demos
# LEONARDO_CONTAINER=$WORK/containers/leonardo-visual-demos.sif

LEONARDO_RUNROOT=$FAST/leonardo_visual_demos
LEONARDO_CPU_QOS=dcgp_qos_dbg
LEONARDO_GPU_QOS=boost_qos_dbg
LEONARDO_PROFILE_MODULE=profile/base
LEONARDO_CUDA_MODULE=cuda/12.2

# Optional site modules required by your chosen Python environment.
# For cineca-ai, change the profile above to profile/deeplrn, then add:
# LEONARDO_EXTRA_MODULES="cineca-ai/<version>"
